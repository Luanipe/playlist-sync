{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/PRD.md",
    "docs/ARCHITECTURE.md",
    "docs/MATCHING.md",
    "docs/AUTH.md",
    "docs/DECISIONS.md",
    "docs/ROADMAP.md",
    "docs/AGENT_WORKFLOW.md"
  ],
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "uv sync*", "effect": "allow" },
    { "action": "shell", "resource": "uv lock*", "effect": "allow" },
    { "action": "shell", "resource": "uv run ruff *", "effect": "allow" },
    { "action": "shell", "resource": "uv run mypy *", "effect": "allow" },
    { "action": "shell", "resource": "uv run pytest *", "effect": "allow" },
    { "action": "shell", "resource": "uv run playlist-sync *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch origin main", "effect": "allow" },
    { "action": "shell", "resource": "git fetch origin main --quiet", "effect": "allow" },
    { "action": "shell", "resource": "git switch *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue create *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue edit *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue comment *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue reopen *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue close *", "effect": "deny" },
    { "action": "shell", "resource": "gh issue delete *", "effect": "deny" },
    { "action": "shell", "resource": "gh issue transfer *", "effect": "deny" },
    { "action": "shell", "resource": "gh issue lock *", "effect": "deny" },
    { "action": "shell", "resource": "gh issue unlock *", "effect": "deny" },
    { "action": "shell", "resource": "gh issue pin *", "effect": "deny" },
    { "action": "shell", "resource": "gh issue unpin *", "effect": "deny" },
    { "action": "shell", "resource": "gh label list *", "effect": "allow" },
    { "action": "shell", "resource": "gh label create *", "effect": "allow" },
    { "action": "shell", "resource": "gh label clone *", "effect": "allow" },
    { "action": "shell", "resource": "gh label delete *", "effect": "deny" },
    { "action": "shell", "resource": "gh label edit *", "effect": "deny" },
    { "action": "shell", "resource": "gh repo view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr status *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr comment *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr ready *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr create *", "effect": "deny" },
    { "action": "shell", "resource": "gh pr edit *", "effect": "deny" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "deny" },
    { "action": "shell", "resource": "gh pr close *", "effect": "deny" },
    { "action": "shell", "resource": "gh api *", "effect": "deny" },
    { "action": "shell", "resource": "scripts/sync_roadmap_issues.py *", "effect": "allow" },
    { "action": "shell", "resource": "python scripts/sync_roadmap_issues.py *", "effect": "allow" },
    { "action": "shell", "resource": "python3 scripts/sync_roadmap_issues.py *", "effect": "allow" },
    { "action": "shell", "resource": "uv run python scripts/sync_roadmap_issues.py *", "effect": "allow" },
    { "action": "shell", "resource": "scripts/open_pr.sh *", "effect": "allow" },
    { "action": "shell", "resource": "./scripts/open_pr.sh *", "effect": "allow" },
    { "action": "shell", "resource": "bash scripts/open_pr.sh *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "edit", "resource": "opencode.json", "effect": "deny" },
    { "action": "edit", "resource": "scripts/**", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/**", "effect": "deny" },
    { "action": "edit", "resource": ".github/workflows/**", "effect": "deny" }
  ]
}
